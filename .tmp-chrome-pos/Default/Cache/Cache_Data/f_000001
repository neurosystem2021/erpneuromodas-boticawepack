/* Neurosoft POS Command Bar — compacto, tecnológico y operativo. */
.pos-page .pos-workspace {
  padding: 4px !important;
}

.pos-page .pos-sale-grid {
  position: relative;
  align-items: stretch !important;
  margin: 0 !important;
  padding: 5px !important;
  overflow: hidden;
  border: 1px solid rgba(42, 210, 211, 0.28);
  border-radius: 16px;
  background:
    radial-gradient(circle at 8% -40%, rgba(49, 224, 213, 0.2), transparent 34%),
    radial-gradient(circle at 94% 140%, rgba(113, 79, 255, 0.14), transparent 35%),
    linear-gradient(120deg, rgba(240, 252, 253, 0.98), rgba(245, 247, 255, 0.98));
  box-shadow: 0 9px 25px rgba(4, 41, 58, 0.11), inset 0 1px rgba(255, 255, 255, 0.9);
}

.pos-page .pos-sale-grid::before {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 4%;
  width: 38%;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, #20e3d2, #7d69ff, transparent);
  filter: drop-shadow(0 0 5px rgba(32, 227, 210, 0.85));
  animation: posCommandSweep 5s ease-in-out infinite alternate;
}

.pos-page .pos-sale-grid > [class*="col-"] {
  z-index: 1;
  padding-right: 4px !important;
  padding-left: 4px !important;
}

.pos-page .pos-customer-panel,
.pos-page .pos-loyalty-panel,
.pos-page .pos-document-panel {
  min-height: 156px !important;
  margin-bottom: 0 !important;
  padding-top: 7px !important;
  padding-bottom: 6px !important;
  border: 1px solid rgba(43, 224, 208, 0.28) !important;
  border-radius: 14px !important;
}

.pos-page .pos-customer-panel {
  padding-right: 7px !important;
  padding-left: 7px !important;
  color: #eaffff;
  background:
    radial-gradient(circle at 0 0, rgba(29, 221, 207, 0.16), transparent 38%),
    linear-gradient(142deg, #04374a 0%, #064e4c 58%, #033b43 100%) !important;
  box-shadow: 0 8px 19px rgba(2, 38, 51, 0.19), inset 0 1px rgba(255, 255, 255, 0.08) !important;
}

.pos-customer-fields-row {
  align-content: flex-start;
  gap: 0 !important;
  margin-right: -3px !important;
  margin-left: -3px !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.pos-meta-field,
.pos-client-block {
  padding-right: 3px !important;
  padding-left: 3px !important;
  border: 0 !important;
  background: transparent !important;
}

.pos-meta-field > .form-group {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: stretch;
  min-height: 38px !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden;
  border: 1px solid rgba(132, 236, 229, 0.48) !important;
  border-radius: 10px !important;
  background: #f9fcff !important;
  box-shadow: 0 5px 12px rgba(0, 24, 39, 0.15), inset 0 1px #fff !important;
}

.pos-meta-field > .form-group::before {
  display: none !important;
}

.pos-meta-field .pos-field-label {
  display: flex !important;
  align-items: center;
  justify-content: center;
  min-width: 58px;
  height: 100%;
  margin: 0 !important;
  padding: 0 7px;
  color: #07546a !important;
  background: linear-gradient(135deg, #c9f3f1, #daf2ff);
  font-size: 0.61rem !important;
  font-weight: 900 !important;
  text-transform: uppercase;
  letter-spacing: 0.035em;
  white-space: nowrap;
}

.pos-meta-store .pos-field-label {
  color: #07634f !important;
  background: linear-gradient(135deg, #c8f5df, #ddf8ee);
}

.pos-meta-terminal .pos-field-label {
  color: #5340a4 !important;
  background: linear-gradient(135deg, #dfd9ff, #e9edff);
}

.pos-meta-field .pos-field-label i {
  margin-right: 4px;
  font-size: 0.65rem !important;
}

.pos-meta-document .lblSerie,
.pos-meta-document .ocultarWeb {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

.pos-meta-field > .form-group > .input-group,
.pos-meta-field > .form-group > input {
  align-self: stretch;
  min-width: 0;
  margin: 0 !important;
}

.pos-page .pos-meta-field .form-control,
.pos-page .pos-meta-field .custom-select {
  min-height: 36px !important;
  height: 36px !important;
  padding: 4px 9px !important;
  border: 0 !important;
  border-radius: 0 !important;
  color: #17354a !important;
  background: rgba(255, 255, 255, 0.96) !important;
  box-shadow: none !important;
  font-size: 0.76rem !important;
  font-weight: 800;
}

.pos-client-block {
  display: block !important;
  flex: 0 0 100% !important;
  max-width: 100% !important;
  margin-top: 5px !important;
}

.pos-client-block > .form-group {
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
}

.pos-client-block > .form-group > .pos-field-label {
  display: none !important;
}

.pos-client-block > .form-group > .input-group:first-of-type {
  overflow: hidden;
  border: 1px solid rgba(116, 235, 230, 0.48);
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 5px 12px rgba(0, 25, 39, 0.15);
}

.pos-page .pos-client-block .form-control,
.pos-page .pos-client-block .custom-select,
.pos-page .pos-client-block .input-group .btn,
.pos-page .pos-client-block .input-group-text {
  min-height: 34px !important;
  height: 34px !important;
  border: 0 !important;
  border-radius: 0 !important;
  font-size: 0.76rem !important;
}

.pos-client-block .input-group > .btn,
.pos-client-block .input-group-prepend .btn {
  min-width: 40px;
  color: #fff !important;
  background: linear-gradient(135deg, #08768a, #075467) !important;
}

.pos-client-block .input-group .btn-primary,
.pos-client-block .input-group-append .btn {
  padding-right: 13px !important;
  padding-left: 13px !important;
  color: #fff !important;
  background: linear-gradient(115deg, #0db2c0, #2773df 66%, #7659f6) !important;
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.2) !important;
}

.pos-client-block > .form-group > .custom-select {
  width: calc(70% - 3px);
  margin: 4px 0 0 auto !important;
  border: 1px solid rgba(114, 229, 224, 0.35) !important;
  border-radius: 9px !important;
  background-color: rgba(249, 253, 255, 0.96) !important;
}

.pos-guarantee-strip {
  min-height: 25px !important;
  margin-top: 4px !important;
  margin-bottom: 0 !important;
  padding: 2px 7px !important;
  border: 1px solid rgba(104, 234, 224, 0.25) !important;
  border-radius: 8px !important;
  color: #dffdf9;
  background: rgba(2, 32, 43, 0.42) !important;
}

.pos-guarantee-strip label,
.pos-guarantee-strip .custom-control-label {
  color: #dffdf9 !important;
  font-size: 0.62rem !important;
}

.pos-guarantee-strip .custom-control {
  min-height: 16px !important;
  margin-right: 6px !important;
}

.pos-customer-panel .custom-checkbox {
  visibility: visible !important;
  min-height: 28px !important;
  margin: 4px 0 0 !important;
  padding: 5px 9px 4px 30px;
  border: 1px solid rgba(115, 235, 227, 0.3);
  border-radius: 9px;
  color: #eaffff;
  background: rgba(3, 40, 52, 0.52);
  opacity: 1 !important;
  font-size: 0.68rem !important;
}

.pos-customer-panel .custom-checkbox label {
  color: #eaffff !important;
}

.pos-page .pos-loyalty-panel {
  color: #effffc;
  background:
    radial-gradient(circle at 85% -10%, rgba(35, 226, 207, 0.22), transparent 52%),
    linear-gradient(150deg, #075b58, #03413f 64%, #06343d) !important;
  box-shadow: 0 8px 19px rgba(1, 44, 48, 0.18), inset 0 1px rgba(255, 255, 255, 0.08) !important;
}

.pos-loyalty-panel .pos-panel-kicker {
  display: flex !important;
  justify-content: center;
  margin-bottom: 2px !important;
  color: #dffefa !important;
  font-size: 0.58rem !important;
}

.pos-loyalty-panel .pos-panel-kicker i {
  color: #ffd35c !important;
}

.pos-loyalty-panel .form-group {
  margin: 0 0 4px !important;
  color: #e9fffc;
  font-size: 0.68rem;
}

.pos-page .pos-loyalty-panel .puntos {
  margin: 1px 0 0 !important;
  color: transparent !important;
  background: linear-gradient(120deg, #ffffff, #77fff0 56%, #ffd266) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  font-size: 2rem !important;
  line-height: 0.95 !important;
  text-shadow: none !important;
}

.pos-loyalty-panel .mt-4 {
  margin-top: 5px !important;
}

.pos-loyalty-panel .pos-field-label {
  margin-bottom: 3px !important;
  color: #bff9f1 !important;
  font-size: 0.58rem !important;
}

.pos-page .pos-loyalty-panel .form-control {
  min-height: 31px !important;
  height: 31px !important;
  border: 1px solid rgba(113, 231, 224, 0.4) !important;
  border-radius: 8px !important;
  background: rgba(255, 255, 255, 0.96) !important;
  font-size: 0.72rem !important;
}

.pos-page .pos-document-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  grid-template-rows: auto auto auto;
  gap: 4px 8px;
  color: #edfffd;
  background:
    radial-gradient(circle at 100% 0%, rgba(30, 222, 207, 0.2), transparent 43%),
    linear-gradient(145deg, #064d4a 0%, #053d3e 48%, #082f41 100%) !important;
  box-shadow: 0 8px 19px rgba(2, 36, 48, 0.2), inset 0 1px rgba(255, 255, 255, 0.08) !important;
}

.pos-document-panel > .pos-panel-kicker {
  grid-column: 1;
  grid-row: 1;
  justify-content: center;
  margin: 0 !important;
  color: #cffff8 !important;
  font-size: 0.58rem !important;
}

.pos-document-panel > .form-group {
  margin: 0 !important;
}

.pos-document-panel > .form-group:nth-of-type(1) {
  grid-column: 1;
  grid-row: 2;
  color: #d8fff8;
  font-size: 0.65rem;
}

.pos-document-panel > .form-group:nth-of-type(2) {
  grid-column: 1;
  grid-row: 3;
  align-self: center;
}

.pos-document-panel > .form-group:nth-of-type(3) {
  display: flex;
  grid-column: 2;
  grid-row: 1 / span 3;
  flex-direction: column;
  justify-content: center;
  padding: 7px;
  border: 1px solid rgba(75, 231, 217, 0.2);
  border-radius: 10px;
  background: rgba(0, 31, 39, 0.32);
}

.pos-document-panel .big-text {
  margin: 2px 0 !important;
  color: #fff !important;
  font-size: 1.28rem !important;
  font-weight: 800 !important;
  line-height: 1 !important;
  text-shadow: 0 4px 13px rgba(0, 0, 0, 0.2);
}

.pos-reference-badge {
  min-height: 23px !important;
  padding: 4px 9px !important;
  border-color: rgba(255, 218, 91, 0.44) !important;
  color: #fff2ad !important;
  background: linear-gradient(115deg, rgba(146, 115, 17, 0.58), rgba(95, 91, 15, 0.45)) !important;
  box-shadow: 0 5px 13px rgba(255, 190, 34, 0.1), inset 0 1px rgba(255, 255, 255, 0.12) !important;
  font-size: 0.58rem !important;
}

.pos-document-panel .pos-field-label-light {
  margin-bottom: 5px !important;
  color: #ffd969 !important;
  font-size: 0.58rem !important;
  text-transform: uppercase;
}

.pos-page .pos-document-panel .form-control {
  min-height: 32px !important;
  height: 32px !important;
  border: 1px solid rgba(93, 231, 221, 0.35) !important;
  border-radius: 8px !important;
  color: #eaffff !important;
  background: rgba(255, 255, 255, 0.11) !important;
  font-size: 0.72rem !important;
}

.pos-page .pos-cart-panel {
  flex: 0 0 100% !important;
  max-width: 100% !important;
  margin-top: 5px;
}

@media (min-width: 1200px) {
  .pos-page .pos-customer-panel { flex: 0 0 47% !important; max-width: 47% !important; }
  .pos-page .pos-loyalty-panel { flex: 0 0 15% !important; max-width: 15% !important; }
  .pos-page .pos-document-panel { flex: 0 0 38% !important; max-width: 38% !important; }
}

@media (min-width: 768px) {
  .pos-customer-fields-row { flex-wrap: wrap !important; }
  .pos-customer-fields-row > .pos-meta-field { flex: 0 0 33.333333% !important; max-width: 33.333333% !important; }
}

@media (min-width: 768px) and (max-width: 1199.98px) {
  .pos-page .pos-customer-panel { flex: 0 0 52% !important; max-width: 52% !important; }
  .pos-page .pos-loyalty-panel { flex: 0 0 18% !important; max-width: 18% !important; }
  .pos-page .pos-document-panel { flex: 0 0 30% !important; max-width: 30% !important; display: block; }
  .pos-document-panel > .form-group:nth-of-type(3) { margin-top: 5px !important; padding: 4px; }
}

@media (max-width: 767.98px) {
  .pos-page .pos-sale-grid { padding: 3px !important; border-radius: 11px; }
  .pos-page .pos-customer-panel,
  .pos-page .pos-loyalty-panel,
  .pos-page .pos-document-panel { min-height: 0 !important; margin-bottom: 5px !important; }
  .pos-page .pos-document-panel { display: block; }
  .pos-document-panel > .form-group:nth-of-type(3) { margin-top: 5px !important; }
}

@keyframes posCommandSweep {
  from { transform: translateX(-4%); opacity: 0.45; }
  to { transform: translateX(145%); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .pos-page .pos-sale-grid::before { animation: none !important; }
}

