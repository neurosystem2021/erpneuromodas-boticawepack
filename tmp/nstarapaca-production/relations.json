    "stock_view": "CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `gen_producto_totales` AS select `p`.`IdProducto` AS `IdProducto`,`a`.`IdAlmacen` AS `IdAlmacen`,coalesce(sum(`x`.`TotalCompras`),0) AS `TotalCompras`,coalesce(sum(`x`.`TotalVentas`),0) AS `TotalVentas` from ((`gen_producto` `p` join `lo_almacen` `a`) left join (select `d`.`IdProducto` AS `IdProducto`,`m`.`IdAlmacenDestino` AS `IdAlmacen`,`d`.`Cantidad` AS `TotalCompras`,0 AS `TotalVentas` from ((`lo_movimiento` `m` join `lo_movimientodetalle` `d` on(`d`.`hashMovimiento` = `m`.`Hash`)) join `lo_movimientotipo` `mt` on(`mt`.`IdMovimientoTipo` = `m`.`IdMovimientoTipo`)) where `m`.`Anulado` = 0 and `mt`.`VaRegCompra` = 1 and `m`.`MovimientoFecha` <= current_timestamp() union all select `d`.`IdProducto` AS `IdProducto`,`m`.`IdAlmacenOrigen` AS `IdAlmacenOrigen`,0 AS `0`,case when `mt`.`CodSunat` = '07' and coalesce(`m`.`NotaIdMotivo`,'') not in ('01','02','06','07') then 0 else `d`.`Cantidad` end from ((`lo_movimiento` `m` join `lo_movimientodetalle` `d` on(`d`.`hashMovimiento` = `m`.`Hash`)) join `lo_movimientotipo` `mt` on(`mt`.`IdMovimientoTipo` = `m`.`IdMovimientoTipo`)) where `m`.`Anulado` = 0 and `mt`.`VaRegCompra` = 1 and `m`.`MovimientoFecha` <= current_timestamp() union all select `d`.`IdProducto` AS `IdProducto`,`v`.`IdAlmacen` AS `IdAlmacen`,0 AS `0`,case when `td`.`CodSunat` = '07' then case when `v`.`NotaIdMotivo` in ('01','02','06','07') then -`d`.`Cantidad` else 0 end else `d`.`Cantidad` end from ((`ve_docventa` `v` join `ve_docventadet` `d` on(`d`.`IdDocVenta` = `v`.`idDocVenta`)) join `ve_docventatipodoc` `td` on(`td`.`IdTipoDoc` = `v`.`IdTipoDoc`)) where `v`.`Anulado` = 0 and `td`.`VaRegVenta` = 1 and `v`.`FechaDoc` <= current_timestamp() union all select `pd`.`IdProductoDet` AS `IdProducto`,`m`.`IdAlmacenDestino` AS `IdAlmacen`,`d`.`Cantidad` * `pd`.`Cantidad` AS `TotalCompras`,0 AS `TotalVentas` from (((`lo_movimiento` `m` join `lo_movimientodetalle` `d` on(`d`.`hashMovimiento` = `m`.`Hash`)) join `lo_movimientotipo` `mt` on(`mt`.`IdMovimientoTipo` = `m`.`IdMovimientoTipo`)) join `gen_productodet` `pd` on(`pd`.`IdProducto` = `d`.`IdProducto`)) where `m`.`Anulado` = 0 and `mt`.`VaRegCompra` = 1 and `m`.`MovimientoFecha` <= current_timestamp() union all select `pd`.`IdProductoDet` AS `IdProductoDet`,`m`.`IdAlmacenOrigen` AS `IdAlmacenOrigen`,0 AS `0`,case when `mt`.`CodSunat` = '07' and coalesce(`m`.`NotaIdMotivo`,'') not in ('01','02','06','07') then 0 else `d`.`Cantidad` * `pd`.`Cantidad` end from (((`lo_movimiento` `m` join `lo_movimientodetalle` `d` on(`d`.`hashMovimiento` = `m`.`Hash`)) join `lo_movimientotipo` `mt` on(`mt`.`IdMovimientoTipo` = `m`.`IdMovimientoTipo`)) join `gen_productodet` `pd` on(`pd`.`IdProducto` = `d`.`IdProducto`)) where `m`.`Anulado` = 0 and `mt`.`VaRegCompra` = 1 and `m`.`MovimientoFecha` <= current_timestamp() union all select `pd`.`IdProductoDet` AS `IdProductoDet`,`v`.`IdAlmacen` AS `IdAlmacen`,0 AS `0`,case when `td`.`CodSunat` = '07' then case when `v`.`NotaIdMotivo` in ('01','02','06','07') then -(`d`.`Cantidad` * `pd`.`Cantidad`) else 0 end else `d`.`Cantidad` * `pd`.`Cantidad` end from (((`ve_docventa` `v` join `ve_docventadet` `d` on(`d`.`IdDocVenta` = `v`.`idDocVenta`)) join `ve_docventatipodoc` `td` on(`td`.`IdTipoDoc` = `v`.`IdTipoDoc`)) join `gen_productodet` `pd` on(`pd`.`IdProducto` = `d`.`IdProducto`)) where `v`.`Anulado` = 0 and `td`.`VaRegVenta` = 1 and `v`.`FechaDoc` <= current_timestamp()) `x` on(`x`.`IdProducto` = `p`.`IdProducto` and `x`.`IdAlmacen` = `a`.`IdAlmacen`)) group by `p`.`IdProducto`,`a`.`IdAlmacen`",
