<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#07111f">
  <title>Neurosoft One | ERP Inteligente</title>
  <link rel="manifest" href="/manifest.json">
  <script src="resources/js/jquery-3.2.1.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    :root {
      --ns-bg: #050b14;
      --ns-panel: rgba(8, 22, 39, .78);
      --ns-text: #f7fbff;
      --ns-muted: #91a8bd;
      --ns-red: #ff2638;
      --ns-red-dark: #d80720;
      --ns-cyan: #27d8ff;
      --ns-blue: #247cff;
      --ns-violet: #8b5cf6;
      --ns-green: #39e7a5;
      --ns-border: rgba(160, 211, 255, .17);
      --ns-shadow: 0 42px 120px rgba(0, 0, 0, .48);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      min-width: 320px;
      min-height: 100%;
      margin: 0;
    }

    body {
      color: var(--ns-text);
      background: var(--ns-bg);
      font-family: "Segoe UI", Inter, Roboto, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    button,
    input {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .neuro-login {
      position: relative;
      display: grid;
      min-height: 100vh;
      min-height: 100svh;
      padding: clamp(18px, 3vw, 46px);
      overflow: hidden;
      place-items: center;
      isolation: isolate;
      background:
        linear-gradient(112deg, rgba(3, 10, 19, .92) 0%, rgba(4, 17, 32, .82) 48%, rgba(3, 9, 17, .92) 100%),
        url("/resources/images/neurosoft-erp-tech-bg-v2.png") center / cover no-repeat;
    }

    .neuro-login::before {
      position: absolute;
      z-index: -2;
      inset: 0;
      content: "";
      opacity: .42;
      background-image:
        linear-gradient(rgba(39, 216, 255, .075) 1px, transparent 1px),
        linear-gradient(90deg, rgba(39, 216, 255, .075) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(circle at center, #000 12%, transparent 76%);
    }

    .neuro-login::after {
      position: absolute;
      z-index: -1;
      inset: 0;
      content: "";
      pointer-events: none;
      background:
        radial-gradient(circle at 12% 16%, rgba(36, 124, 255, .24), transparent 24rem),
        radial-gradient(circle at 88% 74%, rgba(255, 38, 56, .18), transparent 24rem),
        linear-gradient(to top, rgba(2, 7, 14, .78), transparent 45%);
    }

    .ambient {
      position: absolute;
      z-index: -1;
      border-radius: 50%;
      filter: blur(2px);
      pointer-events: none;
    }

    .ambient-one {
      top: -180px;
      right: 9%;
      width: 440px;
      height: 440px;
      border: 1px solid rgba(39, 216, 255, .16);
      box-shadow: inset 0 0 80px rgba(39, 216, 255, .05), 0 0 80px rgba(39, 216, 255, .05);
      animation: orbit 14s ease-in-out infinite alternate;
    }

    .ambient-two {
      bottom: -220px;
      left: 5%;
      width: 500px;
      height: 500px;
      border: 1px solid rgba(255, 38, 56, .14);
      box-shadow: inset 0 0 90px rgba(255, 38, 56, .05), 0 0 90px rgba(255, 38, 56, .05);
      animation: orbit 18s ease-in-out infinite alternate-reverse;
    }

    .experience-shell {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(390px, .65fr);
      width: min(1240px, 100%);
      min-height: min(760px, calc(100vh - 68px));
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .16);
      border-radius: 34px;
      background: rgba(5, 15, 28, .58);
      box-shadow: var(--ns-shadow), inset 0 1px 0 rgba(255, 255, 255, .08);
      backdrop-filter: blur(26px) saturate(125%);
      animation: shellIn .7s cubic-bezier(.2, .8, .2, 1) both;
    }

    .experience-shell::before {
      position: absolute;
      z-index: 2;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      content: "";
      background: linear-gradient(90deg, transparent, var(--ns-cyan), var(--ns-blue), var(--ns-red), transparent);
      background-size: 200% 100%;
      animation: spectrum 5s linear infinite;
    }

    .hero-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
      padding: clamp(36px, 5vw, 72px);
      overflow: hidden;
      border-right: 1px solid var(--ns-border);
      background:
        radial-gradient(circle at 82% 18%, rgba(39, 216, 255, .13), transparent 19rem),
        linear-gradient(145deg, rgba(9, 35, 61, .74), rgba(5, 17, 31, .42));
    }

    .hero-panel::after {
      position: absolute;
      right: -110px;
      bottom: -150px;
      width: 420px;
      height: 420px;
      border: 1px solid rgba(39, 216, 255, .12);
      border-radius: 50%;
      content: "";
      box-shadow: inset 0 0 70px rgba(36, 124, 255, .08);
    }

    .product-badge,
    .system-status {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      width: fit-content;
      border: 1px solid var(--ns-border);
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: .12em;
    }

    .product-badge {
      padding: 9px 14px;
      color: #dff7ff;
      background: rgba(9, 35, 61, .58);
      font-size: .7rem;
      font-weight: 800;
    }

    .product-badge i {
      color: var(--ns-cyan);
    }

    .hero-copy {
      position: relative;
      z-index: 1;
      max-width: 690px;
      margin: clamp(32px, 6vh, 70px) 0;
    }

    .eyebrow {
      display: block;
      margin-bottom: 15px;
      color: var(--ns-cyan);
      font-size: .73rem;
      font-weight: 900;
      letter-spacing: .22em;
    }

    .hero-copy h1 {
      max-width: 760px;
      margin: 0;
      color: #fff;
      font-size: clamp(3rem, 6vw, 6.4rem);
      font-weight: 800;
      line-height: .91;
      letter-spacing: -.065em;
      text-wrap: balance;
    }

    .hero-copy h1 em {
      color: transparent;
      background: linear-gradient(100deg, #fff 0%, #64e8ff 42%, #3a8dff 74%, #a78bfa 100%);
      -webkit-background-clip: text;
      background-clip: text;
      font-style: normal;
    }

    .hero-copy p {
      max-width: 610px;
      margin: 26px 0 0;
      color: #a8bdd0;
      font-size: clamp(.98rem, 1.4vw, 1.14rem);
      line-height: 1.75;
    }

    .module-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .module-card {
      min-width: 0;
      padding: 17px;
      border: 1px solid rgba(156, 211, 255, .13);
      border-radius: 17px;
      background: rgba(255, 255, 255, .045);
      transition: transform .25s ease, border-color .25s ease, background .25s ease;
    }

    .module-card:hover {
      border-color: rgba(39, 216, 255, .35);
      background: rgba(39, 216, 255, .075);
      transform: translateY(-4px);
    }

    .module-icon {
      display: grid;
      width: 38px;
      height: 38px;
      margin-bottom: 13px;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, .14);
      border-radius: 11px;
      color: #fff;
      background: linear-gradient(145deg, rgba(36, 124, 255, .8), rgba(39, 216, 255, .42));
      box-shadow: 0 8px 22px rgba(36, 124, 255, .19);
    }

    .module-card:nth-child(2) .module-icon {
      background: linear-gradient(145deg, rgba(139, 92, 246, .9), rgba(36, 124, 255, .5));
    }

    .module-card:nth-child(3) .module-icon {
      background: linear-gradient(145deg, rgba(255, 38, 56, .88), rgba(255, 105, 60, .55));
    }

    .module-card strong,
    .module-card span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .module-card strong {
      margin-bottom: 4px;
      color: #eef9ff;
      font-size: .86rem;
    }

    .module-card span {
      color: #7891a8;
      font-size: .69rem;
    }

    .hero-footer {
      position: absolute;
      top: 34px;
      right: 34px;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #7590a7;
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .08em;
    }

    .hero-footer::before {
      width: 22px;
      height: 1px;
      content: "";
      background: rgba(39, 216, 255, .55);
    }

    .auth-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
      padding: clamp(32px, 4vw, 58px);
      background: linear-gradient(155deg, rgba(9, 23, 40, .94), rgba(4, 13, 24, .88));
    }

    .system-status {
      position: absolute;
      top: 26px;
      right: 28px;
      padding: 7px 10px;
      color: #bdfce3;
      background: rgba(17, 66, 55, .25);
      font-size: .58rem;
      font-weight: 800;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--ns-green);
      box-shadow: 0 0 0 4px rgba(57, 231, 165, .1), 0 0 14px rgba(57, 231, 165, .8);
      animation: pulse 1.8s ease-in-out infinite;
    }

    .brand-plate {
      display: flex;
      width: 240px;
      height: 90px;
      margin-bottom: 36px;
      padding: 5px 13px;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .7);
      border-radius: 18px;
      background: rgba(255, 255, 255, .95);
      box-shadow: 0 15px 35px rgba(0, 0, 0, .22), inset 0 1px 0 #fff;
    }

    .brand-plate img {
      display: block;
      width: 100%;
      height: auto;
      mix-blend-mode: multiply;
    }

    .auth-copy {
      margin-bottom: 28px;
    }

    .auth-copy .eyebrow {
      margin-bottom: 10px;
      color: #ff6372;
    }

    .auth-copy h2 {
      margin: 0 0 10px;
      color: #fff;
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      line-height: 1.05;
      letter-spacing: -.04em;
    }

    .auth-copy p {
      margin: 0;
      color: var(--ns-muted);
      font-size: .88rem;
      line-height: 1.55;
    }

    .field-group {
      margin-bottom: 17px;
    }

    .field-group label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      color: #c5d5e3;
      font-size: .73rem;
      font-weight: 750;
      letter-spacing: .045em;
    }

    .field-shell {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 56px;
      border: 1px solid rgba(158, 196, 226, .18);
      border-radius: 15px;
      background: rgba(255, 255, 255, .055);
      transition: border-color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .field-shell:focus-within {
      border-color: rgba(39, 216, 255, .72);
      background: rgba(39, 216, 255, .065);
      box-shadow: 0 0 0 4px rgba(39, 216, 255, .08), 0 12px 26px rgba(0, 0, 0, .16);
      transform: translateY(-1px);
    }

    .field-icon {
      display: grid;
      flex: 0 0 52px;
      height: 28px;
      place-items: center;
      border-right: 1px solid rgba(158, 196, 226, .14);
      color: var(--ns-cyan);
      font-size: .9rem;
    }

    .field-shell input {
      width: 100%;
      min-width: 0;
      height: 54px;
      padding: 0 15px;
      border: 0;
      outline: 0;
      color: #f7fbff;
      background: transparent;
      font-size: .91rem;
      font-weight: 650;
    }

    .field-shell input::placeholder {
      color: #617b92;
      font-weight: 500;
    }

    .field-action {
      flex: 0 0 48px;
      height: 48px;
      padding: 0;
      border: 0;
      outline: 0;
      color: #91a8bd;
      background: transparent;
      cursor: pointer;
      transition: color .2s ease, transform .2s ease;
    }

    .field-action:hover,
    .field-action:focus-visible {
      color: var(--ns-cyan);
      transform: scale(1.08);
    }

    .login-error {
      min-height: 20px;
      margin: -3px 0 9px;
      color: #ff7c88;
      font-size: .75rem;
      font-weight: 650;
      text-align: left;
    }

    .login-button {
      position: relative;
      display: flex;
      width: 100%;
      min-height: 58px;
      padding: 0 20px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .2);
      border-radius: 15px;
      outline: 0;
      color: #fff;
      background: linear-gradient(115deg, var(--ns-red-dark), var(--ns-red) 55%, #ff5c3c);
      box-shadow: 0 14px 30px rgba(255, 38, 56, .24), inset 0 1px 0 rgba(255, 255, 255, .25);
      cursor: pointer;
      font-size: .82rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .11em;
      transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;
    }

    .login-button::before {
      position: absolute;
      top: -80%;
      left: -50%;
      width: 30%;
      height: 260%;
      content: "";
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .48), transparent);
      transform: rotate(22deg) translateX(-230%);
      transition: transform .7s ease;
    }

    .login-button:hover:not(:disabled) {
      filter: saturate(1.15) brightness(1.07);
      box-shadow: 0 19px 36px rgba(255, 38, 56, .34), 0 0 0 7px rgba(255, 38, 56, .07);
      transform: translateY(-3px);
    }

    .login-button:hover::before {
      transform: rotate(22deg) translateX(560%);
    }

    .login-button:active:not(:disabled) {
      transform: translateY(-1px) scale(.992);
    }

    .login-button:disabled {
      cursor: wait;
      filter: grayscale(.25);
      opacity: .72;
    }

    .login-button i {
      font-size: .92rem;
    }

    .secure-line {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 18px 0 0;
      color: #6f899f;
      font-size: .67rem;
      line-height: 1.4;
    }

    .secure-line i {
      color: var(--ns-green);
    }

    .support-block {
      margin-top: 30px;
      padding-top: 23px;
      border-top: 1px solid rgba(158, 196, 226, .12);
    }

    .support-title {
      margin: 0 0 12px;
      color: #6f899f;
      font-size: .65rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .16em;
    }

    .support-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
    }

    .support-link {
      display: flex;
      min-width: 0;
      min-height: 48px;
      padding: 9px 11px;
      align-items: center;
      gap: 10px;
      border: 1px solid rgba(158, 196, 226, .12);
      border-radius: 12px;
      color: #a9bccd;
      background: rgba(255, 255, 255, .035);
      text-decoration: none;
      transition: color .2s ease, border-color .2s ease, background .2s ease, transform .2s ease;
    }

    .support-link:hover {
      border-color: rgba(39, 216, 255, .28);
      color: #fff;
      background: rgba(39, 216, 255, .06);
      transform: translateY(-2px);
    }

    .support-link i {
      flex: 0 0 auto;
      color: var(--ns-cyan);
    }

    .support-link div {
      min-width: 0;
    }

    .support-link small,
    .support-link strong {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .support-link small {
      margin-bottom: 2px;
      color: #60788e;
      font-size: .59rem;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .support-link strong {
      font-size: .7rem;
    }

    .brand-site {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 18px;
      color: #526c82;
      font-size: .62rem;
    }

    .brand-site a {
      color: #7892a9;
      text-decoration: none;
    }

    .brand-site a:hover {
      color: var(--ns-cyan);
    }

    @keyframes shellIn {
      from { opacity: 0; transform: translateY(18px) scale(.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes spectrum {
      to { background-position: 200% 0; }
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .65; transform: scale(.72); }
    }

    @keyframes orbit {
      from { transform: translate3d(-12px, -8px, 0) rotate(0deg); }
      to { transform: translate3d(18px, 15px, 0) rotate(7deg); }
    }

    @media (max-width: 980px) {
      .neuro-login {
        padding: 18px;
        overflow-y: auto;
      }

      .experience-shell {
        grid-template-columns: minmax(0, 1fr);
        min-height: auto;
      }

      .hero-panel {
        min-height: 340px;
        padding: 38px;
        border-right: 0;
        border-bottom: 1px solid var(--ns-border);
      }

      .hero-copy {
        margin: 36px 0;
      }

      .hero-copy h1 {
        max-width: 620px;
        font-size: clamp(2.8rem, 10vw, 5rem);
      }

      .auth-panel {
        min-height: 650px;
        padding: 58px clamp(28px, 9vw, 80px) 42px;
      }

      .hero-footer {
        top: 38px;
        right: 38px;
      }
    }

    @media (max-width: 620px) {
      html,
      body {
        width: 100%;
        overflow-x: hidden;
      }

      .neuro-login {
        padding: 0;
        width: 100%;
        max-width: 100vw;
        place-items: stretch;
      }

      .experience-shell {
        width: 100%;
        min-width: 0;
        max-width: 100vw;
        border: 0;
        border-radius: 0;
      }

      .hero-panel {
        width: 100%;
        min-width: 0;
        max-width: 100vw;
        min-height: 270px;
        padding: 28px 22px;
        overflow: hidden;
      }

      .hero-copy {
        margin: 38px 0 0;
      }

      .hero-copy h1 {
        max-width: 100%;
        font-size: clamp(2.35rem, 11.5vw, 3.25rem);
        overflow-wrap: anywhere;
      }

      .hero-copy p,
      .module-grid,
      .hero-footer {
        display: none;
      }

      .auth-panel {
        display: block;
        width: 100vw;
        min-width: 0;
        max-width: 100vw;
        min-height: calc(100svh - 270px);
        padding: 28px 22px 32px;
        overflow: hidden;
        justify-self: start;
      }

      .system-status {
        position: static;
        display: inline-flex;
        margin-bottom: 18px;
      }

      .auth-copy,
      .field-group,
      .field-shell,
      .login-button,
      .support-block,
      .brand-site {
        width: calc(100vw - 44px);
        min-width: 0;
        max-width: calc(100vw - 44px);
      }

      .auth-copy p {
        white-space: normal;
        overflow-wrap: anywhere;
      }

      .field-group label span {
        display: none;
      }

      .brand-plate {
        width: 210px;
        height: 79px;
        margin-bottom: 28px;
      }

      .support-actions {
        grid-template-columns: 1fr;
      }
    }

    @media (max-height: 790px) and (min-width: 981px) {
      .experience-shell {
        min-height: calc(100vh - 34px);
      }

      .hero-panel,
      .auth-panel {
        padding-top: 42px;
        padding-bottom: 36px;
      }

      .hero-copy {
        margin: 34px 0;
      }

      .brand-plate {
        margin-bottom: 25px;
      }

      .auth-copy {
        margin-bottom: 20px;
      }

      .support-block {
        margin-top: 20px;
        padding-top: 18px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
  <style id="neurosoft-elegant-theme">
    :root {
      --elegant-navy: #061323;
      --elegant-ink: #0b2238;
      --elegant-blue: #176cf3;
      --elegant-cyan: #21c8f6;
      --elegant-violet: #725cff;
      --elegant-platinum: #edf6fc;
    }

    .neuro-login {
      padding: clamp(24px, 3.5vw, 58px);
      background:
        linear-gradient(90deg, rgba(3, 12, 24, .88) 0%, rgba(4, 20, 38, .62) 48%, rgba(5, 18, 31, .28) 100%),
        url("/resources/images/neurosoft-erp-tech-bg-v2.png") center / cover no-repeat;
    }

    .neuro-login::before {
      opacity: .3;
      background-size: 56px 56px;
      mask-image: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, .75) 48%, transparent 78%);
    }

    .neuro-login::after {
      background:
        radial-gradient(circle at 15% 10%, rgba(33, 200, 246, .2), transparent 25rem),
        radial-gradient(circle at 86% 78%, rgba(114, 92, 255, .19), transparent 28rem),
        linear-gradient(to top, rgba(2, 8, 16, .78), transparent 56%);
    }

    .ambient-one {
      top: -240px;
      right: 18%;
      width: 560px;
      height: 560px;
      border-color: rgba(33, 200, 246, .11);
    }

    .ambient-two {
      bottom: -300px;
      left: -80px;
